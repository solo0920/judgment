DATABASE_URL=postgresql+psycopg://judgment:judgment@localhost:5432/judgment
# Production should use an absolute persistent path such as /data/laws.
LAW_DATA_DIR=./data/laws
# Judgment archives live under ./data/judgments/raw_rar/ (root .rar also supported).
# JUDGMENT_DATA_DIR is also the root for Parquet snapshots and performance reports.
JUDGMENT_DATA_DIR=./data/judgments
JUDGMENT_LAW_LIST=./documents/金融法規.md
LAW_API_URL=https://law.moj.gov.tw/api/ch/law/json
ORDER_API_URL=https://law.moj.gov.tw/api/ch/order/json
HTTP_TIMEOUT_SECONDS=300
HTTP_RETRIES=3
USER_AGENT=judgment-law-downloader/0.1
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true
MAX_UNCOMPRESSED_BYTES=536870912
# Comma-separated origins for the static frontend. "*" is for local development;
# use the Cloudflare Pages URL in production, e.g. https://judgment.pages.dev
CORS_ALLOW_ORIGINS=*
# Uvicorn proxy-header trust list. "*" trusts any source; set 127.0.0.1 when
# cloudflared is the only local reverse proxy.
FORWARDED_ALLOW_IPS=*
# Start the local power controller on 127.0.0.1:9201 for ./up.sh / ./down.sh.
# Test mode and API Base live in #/status → 系統測試 (or #/tests), not the header.
JUDGMENT_POWER_AGENT=1
# Keep performance_records for at least 90 days.
PERFORMANCE_RETENTION_DAYS=90
# Qdrant is started by docker compose (services: qdrant).
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
JUDGMENT_VECTOR_COLLECTION=judgment_documents
JUDGMENT_VECTOR_ALIAS=judgments_current
JUDGMENT_VECTOR_COLLECTION_PREFIX=judgments
JUDGMENT_EMBEDDING_VERSION=bge-m3@v1
JUDGMENT_INDEX_RECIPE_VERSION=doc-head-tail-v1
JUDGMENT_POINT_ID_VERSION=jid-uuid5-v1
# Local Ollama used for embeddings (bge-m3, 1024 dims) and grounded answers.
EMBEDDING_URL=http://127.0.0.1:11434
EMBEDDING_FALLBACK_URL=
EMBEDDING_FAILOVER_URLS=
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_QUERY_TIMEOUT_SECONDS=2
EMBEDDING_HEALTH_TIMEOUT_SECONDS=2
LLM_URL=http://127.0.0.1:11434
# Fast profile: gemma3:4b answers in ~3-7s on the local machine.
# For higher quality but slower responses, use gemma3:27b.
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=180
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=384
LLM_KEEP_ALIVE=30m
# Retrieval depth, similarity floor and context budget for RAG answers.
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=4000
# Law-first questions use this many judgment excerpts as supporting context.
RAG_LAW_FIRST_JUDGMENT_LIMIT=1
# BGE reranker (llama.cpp /v1/rerank service).
# Start scripts/rerank_server.sh first, then set RAG_RERANK_ENABLED=true.
RAG_RERANK_ENABLED=false
RAG_RERANK_CANDIDATES=30
RERANK_URL=http://x570:11435
RERANK_FALLBACK_URL=http://127.0.0.1:11435
RERANK_MODEL=bge-reranker-v2-m3
RERANK_PORT=11435
RERANK_LOCAL_HOST=127.0.0.1
RERANK_START_LOCAL=auto
RERANK_OLLAMA_MODEL=qllama/bge-reranker-v2-m3:latest
RERANK_TIMEOUT_SECONDS=3
RERANK_CONNECT_TIMEOUT_SECONDS=0.75
RERANK_MAX_CHARS=1200
# Maximum characters embedded per judgment document (head/tail window).
JUDGMENT_INDEX_MAX_CHARS=1600
# 司法院資料開放平臺帳號密碼；判決下載 workflow 會用 MemberTokens 換取 Bearer token。
OPENDATA_JUDICIAL_GOV_TW_ACCOUNT=
OPENDATA_JUDICIAL_GOV_TW_PASSWORD=
# 判決下載：主題分類代碼與已知 fileset 範圍（預設裁判書分類 051）。
JUDGMENT_DOWNLOAD_CATEGORY=051
JUDGMENT_DOWNLOAD_START_ID=71644
JUDGMENT_DOWNLOAD_KNOWN_LATEST_ID=72011
# 非 API 時段下載：預設 true。官方檔案端點實測 24 小時可用；批次與手動 proxy
# 仍一次只處理一個檔案。設為 false 可恢復僅 00:00–06:00（Asia/Taipei）的嚴格時段。
JUDGMENT_DOWNLOAD_ALLOW_OFF_HOURS=true
# 混合版本備份：新 snapshot 只保留 current full raw Parquet，變更/移除的舊 raw
# JSON 寫入 delta Parquet。設為 true 可保留舊 full Parquet 供比對。
JUDGMENT_RAW_PARQUET_KEEP_VERSIONS=false
# 判決下載新版本時，將舊 RAR/7z/zip 移至 raw_rar/history/（預設 true）。
# 設為 false 才會直接刪除舊容器；record-level 舊資料仍由 delta/DB 保存。
JUDGMENT_RAW_RAR_KEEP_VERSIONS=true
# Qdrant 舊向量 history collection；不屬於 judgments_current alias。
JUDGMENT_VECTOR_HISTORY_COLLECTION=judgment_documents_history
# Shared live progress file for the processing page and pipeline commands.
# Defaults to .run/processing_state.json under the repository root.
# JUDGMENT_PROCESSING_STATE=./.run/processing_state.json
# Test mode: empty means auto-discover from Ollama. Set comma-separated
# overrides to limit the models exercised by the header test switch.
TEST_EMBEDDING_MODELS=
TEST_LLM_MODELS=
