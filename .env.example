# Bootstrap only.  Production must create a dedicated NOSUPERUSER/NOCREATEDB/
# NOCREATEROLE role (judgment_app), transfer ownership, then point DATABASE_URL
# here: postgresql+psycopg://judgment_app:<password>@localhost:5432/judgment
# See specs/security/app-db-role-runbook.md.
DATABASE_URL=postgresql+psycopg://judgment:change-me@localhost:5432/judgment
# Used by docker compose to initialize PostgreSQL; keep it in sync with
# DATABASE_URL above.  Existing volumes require an ALTER USER migration.
APP_ENV=production
POSTGRES_PASSWORD=change-me
JUDGMENT_PG_PASSWORD=change-me
# Production should use an absolute persistent path such as /data/laws.
LAW_DATA_DIR=./data/laws
# Judgment archives live under ./data/judgments/raw_rar/ (root .rar also supported).
# JUDGMENT_DATA_DIR is also the root for Parquet snapshots and performance reports.
JUDGMENT_DATA_DIR=./data/judgments
JUDGMENT_LAW_LIST=./documents/金融法規.md
LAW_API_URL=https://law.moj.gov.tw/api/ch/law/json
ORDER_API_URL=https://law.moj.gov.tw/api/ch/order/json
HTTP_TIMEOUT_SECONDS=300
HTTP_RETRIES=3
USER_AGENT=judgment-law-downloader/0.1
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true
# Keep pool_size + max_overflow >= RAG_STREAM_EXECUTOR_WORKERS.
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10
MAX_UNCOMPRESSED_BYTES=536870912
# Explicitly list the frontend origins.  Never use "*": the console contains
# write-capable admin endpoints.  "null" is required for file://.
CORS_ALLOW_ORIGINS=http://127.0.0.1:9200,http://localhost:9200
# Optional: public API base baked into the standalone frontend/ bundle.
# Leave blank for same-origin local use.  Example for Cloudflare Pages:
#   FRONTEND_API_BASE=https://api.example.com
FRONTEND_API_BASE=
# "null" (file://) is intentionally not allowed; add it only for local dev.
# Host header allowlist; add your public hostname explicitly.
TRUSTED_HOSTS=127.0.0.1,localhost,testserver,::1
# Only trust X-Forwarded-* from the local cloudflared/reverse proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
# Required for admin/write endpoints when the request does not originate from
# loopback.  Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JUDGMENT_ADMIN_TOKEN=change-me
# Google OAuth console login.  Create a Web application OAuth client in
# Google Cloud Console and add this authorized redirect URI:
#   http(s)://<host>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; leave blank to derive from the incoming request.
GOOGLE_REDIRECT_URI=
# Only these verified Google accounts may log in.  The first is the default
# administrator; add more comma-separated addresses if needed.
GOOGLE_ALLOWED_EMAILS=solo4study@gmail.com
# Signs the HttpOnly login session.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If blank, JUDGMENT_ADMIN_TOKEN is used for local development only.
# Production (AUTH_COOKIE_SECURE=true or an HTTPS redirect URI) fails fast
# unless this is >=32 characters and different from JUDGMENT_ADMIN_TOKEN.
AUTH_SESSION_SECRET=
# Absolute session lifetime.  12 hours limits stolen-cookie replay; users
# must sign in again after it expires.
AUTH_SESSION_TTL_SECONDS=43200
# lax for same-origin; none (requires HTTPS) for a cross-origin Pages frontend.
AUTH_COOKIE_SAMESITE=lax
# auto uses the request scheme / X-Forwarded-Proto.
AUTH_COOKIE_SECURE=auto
# New Ollama hosts must be listed as host:port (or a URL).  Configured
# EMBEDDING_URL / LLM_URL / RERANK_URL hosts are trusted automatically.
OLLAMA_ALLOWED_HOSTS=127.0.0.1:11434
# Start the local power controller on 127.0.0.1:9201 for ./up.sh / ./down.sh.
# Test mode and API Base live in #/status → 系統測試 (or #/tests), not the header.
JUDGMENT_POWER_AGENT=1
# RAG question/answer and performance_records retention.  A daily maintenance
# task and the 200-write fallback prune use this value.
PERFORMANCE_RETENTION_DAYS=90
# PostgreSQL backups are encrypted with age when this public recipient is set.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=~/.config/judgment/age.key
BACKUP_REQUIRE_ENCRYPTION=1
# Qdrant is started by docker compose (services: qdrant).
QDRANT_URL=http://127.0.0.1:6333
# Required by docker compose and the API client.
QDRANT_API_KEY=change-me
JUDGMENT_VECTOR_COLLECTION=judgment_documents
JUDGMENT_VECTOR_ALIAS=judgments_current
JUDGMENT_VECTOR_COLLECTION_PREFIX=judgments
JUDGMENT_EMBEDDING_VERSION=bge-m3@v1
JUDGMENT_INDEX_RECIPE_VERSION=doc-head-tail-v1
JUDGMENT_POINT_ID_VERSION=jid-uuid5-v1
# Law/order article vectors live in a separate collection; never mix them
# into judgments_v002. Build with judgment-index-legal-articles.
LEGAL_ARTICLE_VECTOR_COLLECTION=legal_articles
LEGAL_ARTICLE_VECTOR_ALIAS=legal_articles_current
LEGAL_ARTICLE_VECTOR_COLLECTION_PREFIX=legal_articles
LEGAL_ARTICLE_EMBEDDING_VERSION=bge-m3@v1
LEGAL_ARTICLE_INDEX_RECIPE_VERSION=law-article-v1
LEGAL_ARTICLE_POINT_ID_VERSION=law-article-uuid5-v1
LEGAL_ARTICLE_INDEX_MAX_CHARS=4000
LEGAL_ARTICLE_INDEX_BATCH_SIZE=32
LEGAL_ARTICLE_PAYLOAD_MAX_CHARS=8000
# Embedding backend. x570 runs bge-m3 on llama-server (OpenAI-compatible).
# Use EMBEDDING_API=ollama and http://127.0.0.1:11434 for a local-only setup.
EMBEDDING_URL=http://x570:11437
EMBEDDING_API=openai
EMBEDDING_FALLBACK_URL=http://127.0.0.1:11437
EMBEDDING_FALLBACK_API=openai
EMBEDDING_FAILOVER_URLS=
EMBEDDING_FAILOVER_APIS=
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_QUERY_TIMEOUT_SECONDS=2
EMBEDDING_HEALTH_TIMEOUT_SECONDS=2
# Chat backend. x570 runs gemma3:4b on llama-server; MBP llama-server is fallback.
# For a local-only setup set LLM_URL=http://127.0.0.1:11436 and LLM_API=openai.
# Demo without the x570 24576 context fix: start scripts/run_mbp_llm_24576.sh,
# then set LLM_URL=http://127.0.0.1:11440 and LLM_NUM_CTX=6144 (slot ctx).
LLM_URL=http://x570:11436
LLM_API=openai
LLM_FALLBACK_URL=http://127.0.0.1:11436
LLM_FALLBACK_MODEL=gemma3:4b
LLM_FALLBACK_API=openai
# Fast profile: gemma3:4b answers in ~3-7s on the local machine.
# For higher quality but slower responses, use gemma3:27b.
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=180
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=384
LLM_MAX_CONCURRENT=4
# x570 -c 24576 -np 4: use 4 concurrent and LLM_NUM_CTX=6144.
# Only set LLM_MAX_CONCURRENT=1 if x570 is back to the old -c 8192 pool.
# Summary lane queue: 4 parallel, 8 waiting, 20s absolute wait deadline.
LLM_ADMISSION_MAX_QUEUE=8
LLM_ADMISSION_INITIAL_SERVICE_SECONDS=4
RAG_SUMMARY_WAIT_DEADLINE_SECONDS=20
# Legacy Ollama-only setting; llama-server does not use keep_alive.
LLM_KEEP_ALIVE=-1
# Retrieval depth, similarity floor and context budget for RAG answers.
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=4000
# Exact index coverage is a multi-million-row count; cache it briefly on the
# request path. Set to 0 to disable the cache.
RAG_COVERAGE_CACHE_TTL_SECONDS=300
# Warm the coverage cache at startup and refresh it before the TTL expires.
RAG_COVERAGE_WARMUP_ENABLED=true
# Entry admission for the RAG stream demo path. Requests beyond the concurrency
# limit wait briefly; if the estimated wait exceeds the ETA limit they receive
# an immediate busy/degraded response instead of making everyone wait.
RAG_ADMISSION_MAX_CONCURRENCY=40
RAG_ADMISSION_MAX_QUEUE=40
RAG_ADMISSION_ETA_LIMIT_SECONDS=30
RAG_ADMISSION_INITIAL_SERVICE_SECONDS=2
RAG_STREAM_EXECUTOR_WORKERS=40
# Experimental: dense-candidate lexical RRF. Off until an A/B benchmark
# shows a measurable ranking benefit.
RAG_LEXICAL_RRF_ENABLED=false
RAG_LEXICAL_RRF_WEIGHT=2.0
# Legal-term semantic expansion: append high-confidence related terms to the
# embedding query only. Exact keyword_list behavior is unaffected.
# Off by default until the proxy A/B benchmark shows a measurable benefit.
RAG_LEGAL_EXPANSION_ENABLED=false
RAG_LEGAL_EXPANSION_TERMS=4
# Court/year exact-term probe limits. Oversized scopes are skipped and
# disclosed instead of running an unbounded full-text scan.
RAG_SCOPE_PROBE_MAX_DOCUMENTS=50000
RAG_SCOPE_PROBE_MAX_HITS=5000
RAG_SCOPE_PROBE_TIMEOUT_MS=3000
# Law-first questions use this many judgment excerpts as supporting context.
RAG_LAW_FIRST_JUDGMENT_LIMIT=1
# Hybrid law/order retrieval. If the alias is missing, RAG falls back to
# PostgreSQL/Parquet + BM25 without failing the request.
RAG_LAW_VECTOR_ENABLED=true
RAG_LAW_VECTOR_CANDIDATES=30
RAG_LAW_SCORE_THRESHOLD=0.25
# Reciprocal Rank Fusion: BM25/concept rank + dense rank. Dense is a weak
# vote by default; raise RAG_LAW_DENSE_WEIGHT to give dense more influence.
RAG_LAW_RRF_K=60
RAG_LAW_DENSE_WEIGHT=0.2
RAG_LAW_ARTICLE_LIMIT=4
RAG_LAW_ARTICLE_LIMIT_LAW_FIRST=6
RAG_LAW_CANDIDATE_ARTICLE_LIMIT=8
RAG_LAW_RERANK_WEIGHT=0.15
RAG_LAW_RERANK_MAX_CHARS=600
# BGE reranker (llama.cpp /v1/rerank service).
# Start scripts/rerank_server.sh first, then set RAG_RERANK_ENABLED=true.
RAG_RERANK_ENABLED=false
# A/B 2026-11-17: 20 candidates x 500 chars cut judgment rerank p50 from
# 572 to 157 ms and stream first_partial p95 from 6.02 to 2.96 s on the
# 27-case suite. Keep 30x1200 until the 10-question human review is done.
RAG_RERANK_CANDIDATES=30

# Optional RAG benchmark regression thresholds. The gate runs when a benchmark
# finishes and via scripts/rag_regression_gate.py.
RAG_GATE_LAW_RECALL_MIN=0.75
RAG_GATE_ARTICLE_RECALL_MIN=0.70
RAG_GATE_JUDGMENT_RECALL_MIN=0.65
RAG_GATE_CITATION_VALID_RATE_MIN=0.95
RAG_GATE_REFUSAL_ACCURACY_MIN=0.90
RAG_GATE_DURATION_P95_MAX_MS=15000
RERANK_URL=http://x570:11435
RERANK_FALLBACK_URL=http://127.0.0.1:11435
RERANK_MODEL=bge-reranker-v2-m3
RERANK_PORT=11435
RERANK_LOCAL_HOST=127.0.0.1
RERANK_START_LOCAL=auto
RERANK_OLLAMA_MODEL=qllama/bge-reranker-v2-m3:latest
RERANK_TIMEOUT_SECONDS=3
RERANK_CONNECT_TIMEOUT_SECONDS=0.75
# Cap the whole primary+fallback rerank phase instead of allowing one
# timeout per endpoint (the 3s+3s tail was the first_partial p95 outlier).
RERANK_TOTAL_TIMEOUT_SECONDS=4
# Keep the reranker model loaded while the console is running.
RERANK_HEARTBEAT_ENABLED=true
RERANK_HEARTBEAT_SECONDS=60
# See the RAG_RERANK_CANDIDATES A/B note above before lowering this.
RERANK_MAX_CHARS=1200
# Maximum characters embedded per judgment document (head/tail window).
JUDGMENT_INDEX_MAX_CHARS=1600
# 司法院資料開放平臺帳號密碼；判決下載 workflow 會用 MemberTokens 換取 Bearer token。
OPENDATA_JUDICIAL_GOV_TW_ACCOUNT=
OPENDATA_JUDICIAL_GOV_TW_PASSWORD=
# 判決下載：主題分類代碼與已知 fileset 範圍（預設裁判書分類 051）。
JUDGMENT_DOWNLOAD_CATEGORY=051
JUDGMENT_DOWNLOAD_START_ID=71644
JUDGMENT_DOWNLOAD_KNOWN_LATEST_ID=72011
# 非 API 時段下載：預設 true。官方檔案端點實測 24 小時可用；批次與手動 proxy
# 仍一次只處理一個檔案。設為 false 可恢復僅 00:00–06:00（Asia/Taipei）的嚴格時段。
JUDGMENT_DOWNLOAD_ALLOW_OFF_HOURS=true
# 混合版本備份：新 snapshot 只保留 current full raw Parquet，變更/移除的舊 raw
# JSON 寫入 delta Parquet。設為 true 可保留舊 full Parquet 供比對。
JUDGMENT_RAW_PARQUET_KEEP_VERSIONS=false
# 判決下載新版本時，將舊 RAR/7z/zip 移至 raw_rar/history/（預設 true）。
# 設為 false 才會直接刪除舊容器；record-level 舊資料仍由 delta/DB 保存。
JUDGMENT_RAW_RAR_KEEP_VERSIONS=true
# Qdrant 舊向量 history collection；不屬於 judgments_current alias。
JUDGMENT_VECTOR_HISTORY_COLLECTION=judgment_documents_history
# Shared live progress file for the processing page and pipeline commands.
# Defaults to .run/processing_state.json under the repository root.
# JUDGMENT_PROCESSING_STATE=./.run/processing_state.json
# Test mode: empty means auto-discover from Ollama. Set comma-separated
# overrides to limit the models exercised by the header test switch.
TEST_EMBEDDING_MODELS=
TEST_LLM_MODELS=
# Production: 0. Keep 1 only for direct local development.
JUDGMENT_ALLOW_LOCAL_ADMIN_BYPASS=0
# Phase 4 gate: keep 0 until per-IP limits, budgets and a kill switch exist.
PUBLIC_RAG_ENABLED=0
# Demo mode: the DB switch controls daily use. Set this to 1 only for an
# emergency hard stop; unset/0 means "do not override the DB".
JUDGMENT_DEMO_HARD_DISABLE=0
JUDGMENT_DEMO_RAG_DAILY_TOKEN_BUDGET=1000000
JUDGMENT_DEMO_RAG_DAILY_REQUEST_LIMIT=400
JUDGMENT_DEMO_RAG_RATE_PER_MINUTE=10
JUDGMENT_DEMO_RAG_RATE_PER_HOUR=60
JUDGMENT_DEMO_RAG_RATE_PER_DAY=200
# Read-only PostgreSQL role for demo /api/query (postgres). If blank, demo
# PostgreSQL queries fail closed instead of using the admin/superuser URL.
DEMO_QUERY_DATABASE_URL=
JUDGMENT_DEMO_QUERY_RATE_PER_MINUTE=20
JUDGMENT_DEMO_QUERY_RATE_PER_HOUR=200
JUDGMENT_DEMO_QUERY_RATE_PER_DAY=500
JUDGMENT_DEMO_POLL_RATE_PER_MINUTE=120
JUDGMENT_DEMO_POLL_RATE_PER_HOUR=3000
JUDGMENT_DEMO_POLL_RATE_PER_DAY=20000
JUDGMENT_DEMO_FEEDBACK_RATE_PER_MINUTE=10
JUDGMENT_DEMO_FEEDBACK_RATE_PER_HOUR=60
JUDGMENT_DEMO_FEEDBACK_RATE_PER_DAY=200
JUDGMENT_DEMO_FEEDBACK_DAILY_LIMIT=1000
# HMAC secret for signed feedback tokens. Falls back to AUTH_SESSION_SECRET /
# JUDGMENT_ADMIN_TOKEN; set a dedicated value in production.
JUDGMENT_FEEDBACK_SECRET=
RAG_FEEDBACK_EDIT_SECONDS=900
RAG_FEEDBACK_TOKEN_TTL_SECONDS=604800
RAG_CONVERSATION_MAX_TURNS=50
RAG_CONVERSATION_DAILY_LIMIT=20
RAG_INTERACTION_RETENTION_DAYS=180
RAG_FEEDBACK_RETENTION_DAYS=180
RAG_PROMPT_VERSION=rag-system-prompt-v1
# Weekly quality-report delivery (scripts/run_quality_report.sh). Leave blank
# to disable a channel. Slack webhooks must use hooks.slack.com.
RAG_QUALITY_REPORT_SLACK_WEBHOOK=
RAG_QUALITY_REPORT_EMAIL_TO=
RAG_QUALITY_REPORT_SMTP_HOST=
RAG_QUALITY_REPORT_SMTP_PORT=587
RAG_QUALITY_REPORT_SMTP_USER=
RAG_QUALITY_REPORT_SMTP_PASSWORD=
RAG_QUALITY_REPORT_EMAIL_FROM=
RAG_QUALITY_REPORT_CONSOLE_URL=
# Optional least-privilege connections for scheduled jobs. The report role
# should be read-only; rotation needs write access only to proposal tables.
RAG_QUALITY_REPORT_DATABASE_URL=
RAG_HOLDOUT_ROTATION_DATABASE_URL=
RAG_QUALITY_REPORT_STATEMENT_TIMEOUT_MS=30000
JUDGMENT_DEMO_QUERY_TIMEOUT_SECONDS=10
# Smoke-test instance only: disables migrations, event socket and warmers.
JUDGMENT_DISABLE_BACKGROUND_TASKS=0
# Explicit development exception; do not use in production.
# JUDGMENT_ALLOW_PUBLIC_BIND=0
